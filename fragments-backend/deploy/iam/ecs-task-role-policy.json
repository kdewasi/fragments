{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FragmentDataInS3",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::${AWS_S3_BUCKET_NAME}/*"
    },
    {
      "Sid": "FragmentMetadataInDynamoDB",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${AWS_DYNAMODB_TABLE_NAME}"
    }
  ]
}
