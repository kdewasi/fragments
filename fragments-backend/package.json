{
  "name": "fragments",
  "version": "1.0.0",
  "private": true,
  "description": "Fragments back-end API: store, retrieve and convert small text, JSON and image fragments",
  "author": "Kishan Dewasi",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/kdewasi/fragments"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development LOG_LEVEL=debug nodemon src/index.js --watch src",
    "debug": "cross-env NODE_ENV=development LOG_LEVEL=debug nodemon --inspect=0.0.0.0:9229 src/index.js --watch src",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "test:integration": "hurl --test --variables-file tests/integration/vars.env --glob \"tests/integration/**/*.hurl\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1142.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/lib-dynamodb": "^3.1142.0",
    "aws-jwt-verify": "^5.2.1",
    "compression": "^1.8.2",
    "content-type": "^1.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-auth": "^4.2.1",
    "http-auth-passport": "^1.0.7",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.2",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.5",
    "stoppable": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "aws-sdk-client-mock": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
