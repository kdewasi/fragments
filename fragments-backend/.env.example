# Copy to .env for local development. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
# Public URL used to build Location headers (defaults to the request host)
API_URL=http://localhost:8080
# Comma-separated browser origins allowed by CORS (empty = any origin)
CORS_ORIGINS=http://localhost:1234
# Set to 1 when running behind a single reverse proxy / load balancer
TRUST_PROXY=
# Requests per minute per client IP
RATE_LIMIT_MAX=300
# Largest accepted fragment body
MAX_FRAGMENT_SIZE=5mb

# ── Authentication (choose ONE) ───────────────────────────────────────────
# Development only: HTTP Basic Auth with an .htpasswd file
HTPASSWD_FILE=tests/.htpasswd
# Production: Amazon Cognito (ID tokens sent as Bearer tokens)
# AWS_COGNITO_POOL_ID=us-east-1_xxxxxxxxx
# AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Storage ───────────────────────────────────────────────────────────────
# Leave AWS_REGION empty to use in-memory storage. Set it to use S3 + DynamoDB.
AWS_REGION=
AWS_S3_BUCKET_NAME=fragments
AWS_DYNAMODB_TABLE_NAME=fragments
# LocalStack / DynamoDB Local (see docker-compose.yml)
# AWS_S3_ENDPOINT_URL=http://localhost:4566
# AWS_DYNAMODB_ENDPOINT_URL=http://localhost:8000
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
