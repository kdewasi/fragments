# Environment used by the Jest unit tests (loaded by jest.config.js)
NODE_ENV=test
PORT=8080
LOG_LEVEL=silent
LOG_PRETTY=false
HTPASSWD_FILE=tests/.htpasswd
# Empty region => in-memory storage
AWS_REGION=
AWS_COGNITO_POOL_ID=
AWS_COGNITO_CLIENT_ID=
RATE_LIMIT_MAX=10000
FRAGMENTS_STORAGE=
BLOB_READ_WRITE_TOKEN=
