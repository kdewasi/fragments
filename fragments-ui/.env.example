# Fragments UI configuration. Vite inlines VITE_* variables at build time.
# For local development copy this file to .env (or edit .env.development).

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8080

# 'basic' (HTTP Basic Auth, local development only) or 'cognito' (production)
VITE_AUTH_MODE=basic

# Required when VITE_AUTH_MODE=cognito
# VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, defaults to <origin>/callback (must be registered in the Cognito app client)
# VITE_COGNITO_REDIRECT_URI=https://app.example.com/callback

VITE_APP_VERSION=1.0.0
